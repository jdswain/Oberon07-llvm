MODULE ORGW; (* 65C816 .816 module serializer — companion to ORG.

   Writes the self-contained relocatable .816 file from ORG's finalized
   backend state: code + reloc (read from OCG), TD data, strings, the
   exno-indexed export/entry table, per-variable pointer maps, and the
   TD/vtable fixup sections. A LEAF module — imports OCG (code/reloc
   readout), ORB (symbol-table walk) and Files (output), never ORG, so
   there is no import cycle: ORG.Close finalizes the code then calls
   ORGW.WriteModule, passing the state (arrays by reference). *)
  IMPORT OCG, ORB, Files;

  CONST
    CodeOrg = 0;    (* .816 code base offset *)
    maxEnt = 256;   (* max export-table entries, indexed by exno *)
    (* array caps — MUST stay equal to ORG's maxStrx/maxTD/maxVtFix: ORG owns
       the ModArrays variable and its bounds checks use those consts. *)
    maxStrx = 16000; maxTD = 160; maxVtFix = 512;

  TYPE
    (* ORG's finalized module-image scalars, snapshotted by ORG.Close *)
    ModInfo* = RECORD
      key*, nofent*, version*, varsize*, strx*, tdx*, entry*: LONGINT;
      fixorgP*, fixorgD*, fixorgT*, tdListC*, tdFixupC*, vtFixC*: LONGINT
    END;
    (* ORG's module-image arrays. Single source of truth: ORG declares the
       variable, fills it during codegen, and passes it here by reference.
       Only pointer-free arrays go here — tdList (ARRAY OF ORB.Type) is passed
       separately so this record's type descriptor needs no 160-slot pointer
       map (which would overflow the backend's maxTD). *)
    ModArrays* = RECORD
      str*: ARRAY maxStrx OF INTEGER;
      data*: ARRAY maxTD OF LONGINT;
      tdFixupOff*, tdFixupMno*: ARRAY maxTD OF INTEGER;
      vtFixOff*, vtFixMno*, vtFixExno*: ARRAY maxVtFix OF LONGINT
    END;

  PROCEDURE NofPtrs(typ: ORB.Type): LONGINT;
    VAR fld: ORB.Object; n: LONGINT;
  BEGIN
    IF (typ.form = ORB.Pointer) OR (typ.form = ORB.NilTyp) THEN n := 1
    ELSIF typ.form = ORB.Record THEN
      fld := typ.dsc; n := 0;
      WHILE fld # NIL DO n := NofPtrs(fld.type) + n; fld := fld.next END
    ELSIF typ.form = ORB.Array THEN n := NofPtrs(typ.base) * typ.len
    ELSE n := 0
    END;
    RETURN n
  END NofPtrs;

  (* --- .816 writer helpers --- *)
  PROCEDURE Write4(VAR R: Files.Rider; v: LONGINT);
  BEGIN
    Files.WriteByte(R, v MOD 100H);
    Files.WriteByte(R, v DIV 100H MOD 100H);
    Files.WriteByte(R, v DIV 10000H MOD 100H);
    Files.WriteByte(R, v DIV 1000000H MOD 100H)
  END Write4;

  PROCEDURE FindPtrs(VAR R: Files.Rider; typ: ORB.Type; adr: LONGINT);
    VAR fld: ORB.Object; i, s: LONGINT;
  BEGIN
    IF (typ.form = ORB.Pointer) OR (typ.form = ORB.NilTyp) THEN
      Write4(R, adr)
    ELSIF typ.form = ORB.Record THEN
      fld := typ.dsc;
      WHILE fld # NIL DO FindPtrs(R, fld.type, fld.val + adr); fld := fld.next END
    ELSIF typ.form = ORB.Array THEN
      s := typ.base.size; i := 0;
      WHILE i < typ.len DO FindPtrs(R, typ.base, i * s + adr); i := i + 1 END
    END
  END FindPtrs;


  PROCEDURE WriteModule*(modid: ARRAY OF CHAR; VAR info: ModInfo; VAR wa: ModArrays;
      VAR tdList: ARRAY OF ORB.Type);
    VAR obj: ORB.Object; i, comsize, nofimps, nofptrs, size: LONGINT;
      name: ARRAY 256 OF CHAR; F: Files.File; R: Files.Rider;
      entryVal: ARRAY maxEnt OF LONGINT;
      key, nofent, version, varsize, strx, tdx, entry: LONGINT;
      fixorgP, fixorgD, fixorgT, tdListC, tdFixupC, vtFixC: LONGINT;
  BEGIN
    key := info.key; nofent := info.nofent; version := info.version;
    varsize := info.varsize; strx := info.strx; tdx := info.tdx; entry := info.entry;
    fixorgP := info.fixorgP; fixorgD := info.fixorgD; fixorgT := info.fixorgT;
    tdListC := info.tdListC; tdFixupC := info.tdFixupC; vtFixC := info.vtFixC;
    (* deferred descriptors already generated by FinalizeTDs (before Export,
       so record T.len is written to the .smb — cross-module type tests and
       NEW read it) *)

    obj := ORB.topScope.next;
    nofimps := 0; comsize := 4; nofptrs := 0;
    WHILE obj # NIL DO
      IF (obj.class = ORB.Mod) & (obj.dsc # ORB.systemScope) THEN
        nofimps := nofimps + 1
      ELSIF (obj.exno # 0) & (obj.class = ORB.Const) &
            (obj.type.form = ORB.Proc) & (obj.type.nofpar = 0) &
            (obj.type.base = ORB.noType) THEN
        i := 0; WHILE obj.name[i] # 0X DO i := i + 1 END;
        i := (i + 4) DIV 4 * 4;
        comsize := comsize + i + 4
      ELSIF obj.class = ORB.Var THEN
        nofptrs := nofptrs + NofPtrs(obj.type)
      END;
      obj := obj.next
    END;

    size := varsize + strx + comsize + (OCG.Here() + nofimps + nofent + nofptrs + 1) * 4;

    i := 0; WHILE modid[i] # 0X DO name[i] := modid[i]; i := i + 1 END;
    name[i] := "."; name[i + 1] := "8"; name[i + 2] := "1"; name[i + 3] := "6";
    name[i + 4] := 0X;
    F := Files.New(name);
    Files.Set(R, F, 0);
    Files.WriteString(R, modid);
    Write4(R, key);
    Files.WriteByte(R, version MOD 100H);
    Write4(R, size);

    obj := ORB.topScope.next;
    WHILE (obj # NIL) & (obj.class = ORB.Mod) DO
      IF obj.dsc # ORB.systemScope THEN
        Files.WriteString(R, obj(ORB.Module).orgname);
        Write4(R, obj.val)
      END;
      obj := obj.next
    END;
    Files.WriteByte(R, 0);

    Write4(R, tdx * 2);
    i := 0;
    WHILE i < tdx DO
      Files.WriteByte(R, wa.data[i] MOD 100H);
      Files.WriteByte(R, wa.data[i] DIV 100H MOD 100H);
      i := i + 1
    END;

    Write4(R, varsize);
    Write4(R, strx);
    i := 0; WHILE i < strx DO Files.WriteByte(R, wa.str[i] MOD 100H); i := i + 1 END;

    Write4(R, OCG.Here() - CodeOrg);
    i := 0;
    WHILE i < OCG.Here() - CodeOrg DO
      Files.WriteByte(R, OCG.Get(i) MOD 100H); i := i + 1
    END;

    obj := ORB.topScope.next;
    WHILE obj # NIL DO
      IF (obj.exno # 0) & (obj.class = ORB.Const) &
         (obj.type.form = ORB.Proc) & (obj.type.nofpar = 0) &
         (obj.type.base = ORB.noType) THEN
        Files.WriteString(R, obj.name);
        Write4(R, obj.val)
      END;
      obj := obj.next
    END;
    Files.WriteByte(R, 0);

    Write4(R, nofent);
    Write4(R, entry);

    (* Build the export table indexed by exno (the loader indexes exports[]
       by exno), merging module-level procs/vars/types with methods — which
       live in each record's meth list, not topScope. A method's entry is its
       CODE address (backend), so importers can reach it by mno:exno. *)
    i := 0; WHILE i < maxEnt DO entryVal[i] := 0; i := i + 1 END;
    obj := ORB.topScope.next;
    WHILE obj # NIL DO
      IF (obj.exno # 0) & (obj.exno < maxEnt) THEN
        IF ((obj.class = ORB.Const) & (obj.type.form = ORB.Proc)) OR
           (obj.class = ORB.Var) THEN
          entryVal[obj.exno] := obj.val
        ELSIF (obj.class = ORB.Const) &
              ((obj.type.form = ORB.Array) OR (obj.type.form = ORB.Record)) THEN
          entryVal[obj.exno] := varsize + obj.val
        ELSIF obj.class = ORB.Typ THEN
          IF obj.type.form = ORB.Record THEN
            entryVal[obj.exno] := obj.type.len MOD 10000H
          ELSIF (obj.type.form = ORB.Pointer) &
                ((obj.type.base.typobj = NIL) OR (obj.type.base.typobj.exno = 0)) THEN
            entryVal[obj.exno] := obj.type.base.len MOD 10000H
          END
        END
      END;
      obj := obj.next
    END;
    i := 0;
    WHILE i < tdListC DO
      obj := tdList[i].meth;
      WHILE obj # NIL DO
        IF (obj.exno # 0) & (obj.exno < maxEnt) THEN entryVal[obj.exno] := obj.backend END;
        obj := obj.next
      END;
      i := i + 1
    END;
    i := 1;
    WHILE i < nofent DO Write4(R, entryVal[i]); i := i + 1 END;

    obj := ORB.topScope.next;
    WHILE obj # NIL DO
      IF obj.class = ORB.Var THEN FindPtrs(R, obj.type, obj.val) END;
      obj := obj.next
    END;

    Write4(R, -1);
    Write4(R, fixorgP);
    Write4(R, fixorgD);
    Write4(R, fixorgT);

    Write4(R, tdFixupC);
    i := 0;
    WHILE i < tdFixupC DO
      Files.WriteByte(R, wa.tdFixupOff[i] MOD 100H);
      Files.WriteByte(R, wa.tdFixupOff[i] DIV 100H MOD 100H);
      Files.WriteByte(R, wa.tdFixupMno[i] MOD 100H);
      Files.WriteByte(R, wa.tdFixupMno[i] DIV 100H MOD 100H);
      i := i + 1
    END;

    (* vtable fixups: an imported inherited method's slot, resolved by the
       loader to (import_base + exports[exno]) - this_module_code_base so the
       codeBase+slot dispatch lands in the base module. offset(4) mno(2) exno(2). *)
    Write4(R, vtFixC);
    i := 0;
    WHILE i < vtFixC DO
      Write4(R, wa.vtFixOff[i]);
      Files.WriteByte(R, wa.vtFixMno[i] MOD 100H);
      Files.WriteByte(R, wa.vtFixMno[i] DIV 100H MOD 100H);
      Files.WriteByte(R, wa.vtFixExno[i] MOD 100H);
      Files.WriteByte(R, wa.vtFixExno[i] DIV 100H MOD 100H);
      i := i + 1
    END;

    Write4(R, OCG.RelCount());
    i := 0;
    WHILE i < OCG.RelCount() DO Write4(R, OCG.Rel(i)); i := i + 1 END;

    Write4(R, entry);
    Files.WriteByte(R, ORD("O"));
    Files.Register(F)
  END WriteModule;
END ORGW.
